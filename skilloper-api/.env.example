# Copy this file to .env and fill in your values
# NOTE: Set APP_ENV=development in your shell BEFORE running the app
#       (the .env file is only loaded when APP_ENV=development)

# Server
PORT=8080

# Database
DB_DRIVER=sqlite
DATABASE_PATH=skilloper.db
# DATABASE_URL=postgres://user:password@localhost:5432/skilloper?sslmode=disable

# CORS
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Authentication (required)
JWT_SECRET=your-development-secret-key-min-32-characters
JWT_EXPIRY=24

# Admin User (required - created on first startup)
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=Admin123!

# Rate Limiting (disabled by default, requires Redis when enabled)
# Format: count-period where period is S(second), M(minute), H(hour), D(day)
# IP-only limits are automatically set to 3x these values to prevent username rotation attacks
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=5-M
# RATE_LIMIT_REGISTER=3-M
# RATE_LIMIT_API=120-M

# Redis (required when RATE_LIMIT_ENABLED=true)
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=skilloper

# TLS (optional - enables HTTPS when both are set)
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem
